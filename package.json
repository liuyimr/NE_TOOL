{
  "name": "ne-engineer-toolbox",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "网络工程师、建筑智能化（弱电）与工业自动化工程师的离线工具箱：43 个常用计算与速查，纯前端、免登录、手机电脑都能用、断网也能用。",
  "keywords": [
    "engineer-toolbox",
    "network-engineer",
    "subnet-calculator",
    "cidr",
    "t568a",
    "t568b",
    "rj45",
    "modbus",
    "plc",
    "scada",
    "4-20ma",
    "pt100",
    "工业自动化",
    "建筑智能化",
    "弱电",
    "综合布线",
    "网络工程师",
    "电工计算",
    "速查手册",
    "offline-first",
    "pwa"
  ],
  "author": "Liuyi <yimr@sohu.com> (新易科技工作室 NewE)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liuyi/NE_TOOL.git"
  },
  "homepage": "https://github.com/Liuyi/NE_TOOL#readme",
  "bugs": {
    "url": "https://github.com/Liuyi/NE_TOOL/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:single": "tsc --noEmit -p tsconfig.json && vite build --mode single",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "node scripts/run-tests.mjs --watch"
  },
  "dependencies": {
    "fuse.js": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^2.0.0"
  }
